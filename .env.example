# Copy to .env to override docker compose defaults.
# Host or LAN IP that browsers use to reach this stack. Set to this machine's LAN IP to upload from a phone.
PUBLIC_HOST=localhost
# Host port for the NGINX media edge + player (default 8080).
MEDIA_PORT=8080
# Map domains through a reverse proxy or tunnel (README "Use your own domains"). Set all of these together.
# PUBLIC_API_BASE_URL=https://api.example.com
# PUBLIC_MEDIA_BASE_URL=https://media.example.com/media
# MINIO_PUBLIC_ENDPOINT=s3.example.com
# MINIO_PUBLIC_SECURE=true
# Replace the development credentials before exposing the stack.
# API_KEYS=admin:CHANGE_ME:admin
# MINIO_ROOT_USER=CHANGE_ME
# MINIO_ROOT_PASSWORD=CHANGE_ME
# Publish ports on loopback only, so traffic has to pass through a proxy on this machine.
# BIND_ADDRESS=127.0.0.1
# Grafana host port for the monitoring profile (default 3000).
GRAFANA_PORT=3000
# Shorter leases make crash recovery observable quickly in local tests.
# JOB_LEASE_SECONDS=30
# JOB_HEARTBEAT_SECONDS=5
# RECOVERY_INTERVAL_SECONDS=10
# MAX_CONCURRENT_JOBS=0
# Use a mirrored MinIO image instead of building from source.
# MINIO_IMAGE=registry.example.com/minio:RELEASE.2025-04-22T22-12-26Z
