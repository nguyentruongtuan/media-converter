# Copy to .env to override docker compose defaults.
# Host or LAN IP that browsers use to reach this stack. Set to this machine's LAN IP to upload from a phone.
PUBLIC_HOST=localhost
# Host port for the NGINX media edge + player (default 8080).
MEDIA_PORT=8080
# Grafana host port for the monitoring profile (default 3000).
GRAFANA_PORT=3000
# Shorter leases make crash recovery observable quickly in local tests.
# JOB_LEASE_SECONDS=30
# JOB_HEARTBEAT_SECONDS=5
# RECOVERY_INTERVAL_SECONDS=10
# MAX_CONCURRENT_JOBS=0
# Use a mirrored MinIO image instead of building from source.
# MINIO_IMAGE=registry.example.com/minio:RELEASE.2025-04-22T22-12-26Z
