# ${MINIO_UPSTREAM}, ${OUTPUT_BUCKET} and ${NGINX_RESOLVER} are substituted from the environment at start.

# Resolve MinIO per request (not once at startup) so NGINX survives DNS races and MinIO restarts.
resolver ${NGINX_RESOLVER} valid=30s ipv6=off;

# Enforce HLS/MP4 MIME types regardless of what is stored on the object.
map $uri $media_content_type {
    default                 application/octet-stream;
    ~*\.m3u8$               application/vnd.apple.mpegurl;
    ~*\.ts$                 video/mp2t;
    ~*\.m4s$                video/iso.segment;
    ~*\.mp4$                video/mp4;
    ~*\.jpe?g$              image/jpeg;
}

map $uri $media_cache_control {
    default                 "public, max-age=31536000, immutable";
    ~*\.m3u8$               "public, max-age=60";
}

proxy_cache_path /var/cache/nginx/media levels=1:2 keys_zone=media:50m max_size=10g inactive=7d use_temp_path=off;

server {
    listen 8080;
    server_tokens off;

    types {
        text/html                       html;
        application/javascript          js;
        text/css                        css;
        application/vnd.apple.mpegurl   m3u8;
        video/mp2t                      ts;
        video/mp4                       mp4;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
    }

    location /media/ {
        limit_except GET HEAD OPTIONS { deny all; }

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "*";
            add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS";
            add_header Access-Control-Allow-Headers "Range";
            add_header Access-Control-Max-Age 86400;
            return 204;
        }

        # 1 MiB slices make byte-range requests (MP4 seeking) cacheable.
        slice 1m;
        proxy_cache media;
        proxy_cache_key $uri$slice_range;
        proxy_cache_valid 200 206 1h;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating;
        proxy_set_header Range $slice_range;

        set $minio_upstream ${MINIO_UPSTREAM};
        rewrite ^/media/(.*)$ /${OUTPUT_BUCKET}/$1 break;
        proxy_pass http://$minio_upstream;
        proxy_set_header Host ${MINIO_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Authorization "";

        proxy_hide_header Content-Type;
        proxy_hide_header Cache-Control;
        proxy_hide_header Set-Cookie;
        proxy_hide_header x-amz-request-id;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header X-Amz-Bucket-Region;
        proxy_intercept_errors on;
        error_page 403 =404 /404.html;

        add_header Content-Type $media_content_type always;
        add_header Cache-Control $media_cache_control always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Expose-Headers "Content-Length, Content-Range" always;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    location = /404.html {
        internal;
        return 404 "not found\n";
    }
}
